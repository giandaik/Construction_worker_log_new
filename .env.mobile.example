# Build-time config for the Capacitor mobile bundle (`npm run build:mobile`).
#
# Copy to `.env.mobile` (gitignored) and set the URL of the deployed backend.
# This file is read only by `scripts/build-mobile.mjs`; the web build ignores it
# entirely, so `npm run build` is unaffected by anything here.

# Absolute base URL every `apiFetch()` call is resolved against. Required — the
# WebView origin (capacitor://localhost on iOS, http://localhost on Android) has
# no server behind it. No trailing slash needed.
NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app

# The backend must also allow the WebView origins via CORS. `capacitor://localhost`
# and `http://localhost` are allowed by default (see lib/cors.ts); set
# CORS_ALLOWED_ORIGINS on the *backend* deployment to add any others.
