# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ignore every .env* variant, including the per-machine
# test/review files (.env.mt-test holds MONGODB_URI and NEXT_JWT_SECRET).
# Only the *.example templates are tracked.
.env*
!.env*.example

# vercel
.vercel

# capacitor native builds — the ios/ and android/ projects themselves are
# committed; these are per-machine build output and dependency caches.
# (Capacitor also writes nested .gitignore files covering the same paths.)
ios/App/Pods/
ios/App/build/
android/.gradle/
android/app/build/
android/local.properties

# scratch space used by scripts/build-mobile.mjs; only survives a hard crash
.mobile-build-backup/

# typescript
*.tsbuildinfo
next-env.d.ts

# Fiberplane local issue tracking
.fp/*
!.fp/remote.toml

# private planning docs
docs/commercialization-plan.md


# PDF sheet build artifacts (font download cache, rendered previews)
.pdf-font-cache/
.pdf-preview/

# multi-tenant verification run output (regenerate with scripts/mt-verify)
scripts/mt-verify/report-*.json
scripts/mt-verify/results.jsonl
scripts/mt-verify/fixture.json
# quarantined build artefacts (mv-aside, never committed)
*.stale-*

# Android release signing — the keystore and its passwords never enter git.
android/keystore.properties
*.keystore
*.jks
!android/keystore.properties.example
