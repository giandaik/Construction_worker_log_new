<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext off everywhere: the token travels in an Authorization header
         and the app talks to the deployed HTTPS backend only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
